{
  "name": "mobile-recetas",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel -c",
    "prebuild:android": "expo prebuild --platform android",
    "android:sdk:setup": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-android-sdk.ps1",
    "android": "expo run:android",
    "apk:debug": "cd android && gradlew.bat assembleDebug",
    "apk:release": "cd android && gradlew.bat assembleRelease",
    "apk:install": "powershell -ExecutionPolicy Bypass -File ./scripts/install-debug-apk.ps1 -BuildType release",
    "apk:install:release": "powershell -ExecutionPolicy Bypass -File ./scripts/install-debug-apk.ps1 -BuildType release",
    "apk:install:debug": "powershell -ExecutionPolicy Bypass -File ./scripts/install-debug-apk.ps1 -BuildType debug",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "dependencies": {
    "@expo-google-fonts/quicksand": "^0.4.0",
    "expo": "~55.0.6",
    "expo-linear-gradient": "~55.0.13",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "~55.0.16",
    "react": "19.2.0",
    "react-native": "0.83.6"
  },
  "devDependencies": {
    "babel-preset-expo": "~55.0.8"
  }
}
